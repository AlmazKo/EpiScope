#!/usr/bin/env bash
# cc-open <session-id> [claude-desktop-session-id] — bring the user to the terminal window or application
# running that Claude Code / Codex session.
# Falls back to opening a fresh kitty at the session's cwd when the
# session has no terminal window. Exit 1 = session unknown, nothing done.
#
# Resolution comes from ~/.claude/state/cc-states.json (published by
# EpiScope's TerminalTracker); cwd fallback from ~/.claude/sessions/*.json.
#
# This script ships inside EpiScope.app and must match the snapshot schema
# published by the same EpiScope version.

# System binaries first. cc-open inherits EpiScope's environment, and a
# LaunchAgent-started app takes its PATH from `launchctl setenv`, which any
# local process can rewrite — a planted `python3` earlier on PATH would run
# before any branch below. kitten and agtermctl still resolve normally.
PATH="/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# Everything below is resolved from files any local process can write
# (~/.claude/state/cc-states.json) and ends up in a URL, an `open -b`
# argument or an AppleScript argument. Real session ids are uuids (the
# Claude app prefixes local_), real bundle ids are reverse-DNS.
ok_id() {
  case "$1" in ''|*[!A-Za-z0-9._-]*) return 1 ;; *) return 0 ;; esac
}
ok_bundle() {
  case "$1" in ''|-*|*[!A-Za-z0-9.-]*) return 1 ;; *) return 0 ;; esac
}

SID="$1"
[ -z "$SID" ] && { echo "usage: cc-open <session-id>" >&2; exit 2; }
ok_id "$SID" || { echo "cc-open: refusing malformed session id" >&2; exit 2; }
CLAUDE_DESKTOP_SID="${2:-}"
[ -n "$CLAUDE_DESKTOP_SID" ] && { ok_id "$CLAUDE_DESKTOP_SID" || exit 2; }

# Historical Claude App sessions may have no live cc-states entry. The table
# supplies the metadata's cliSessionId explicitly; Claude uses it to bridge the
# indexed local_<uuid> record to the exact Code/Cowork session in the app.
if [ -n "$CLAUDE_DESKTOP_SID" ]; then
  open "claude://code/$CLAUDE_DESKTOP_SID" 2>/dev/null && exit 0
  open -b com.anthropic.claudefordesktop 2>/dev/null && exit 0
fi

KITTEN="${KITTEN:-/Applications/kitty.app/Contents/MacOS/kitten}"
[ -x "$KITTEN" ] || KITTEN="$(command -v kitten || true)"

eval "$(/usr/bin/env python3 - "$SID" <<'EOF'
import glob, json, os, shlex, sys, time
sid = sys.argv[1]
home = os.path.expanduser("~")
term = ref = bundle_id = sock = cwd = ""
snap = os.path.join(home, ".claude/state/cc-states.json")
try:
    if time.time() - os.path.getmtime(snap) < 5:
        data = json.load(open(snap))
        if data.get("v") == 1:
            # One session id can map to several live instances (e.g. resumed in
            # a new terminal while the old one lingers), so rank the matches
            # instead of taking the first: jump to the focused window, else the
            # most recently launched instance (its per-pid session file
            # startedAt) — stable, unlike a file mtime that jumps on every
            # status write. A resume started later than the original wins.
            matches = [(pid, e) for pid, e in data["states"].items()
                       if e.get("session_id") == sid]
            def _rank(item):
                pid, e = item
                started = 0
                try:
                    with open(os.path.join(home, ".claude/sessions", pid + ".json")) as fh:
                        started = json.load(fh).get("startedAt") or 0
                except Exception:
                    pass
                return (1 if e.get("focused") else 0, started)
            if matches:
                _, e = max(matches, key=_rank)
                term, ref = e.get("term") or "", str(e.get("ref") or "")
                bundle_id = e.get("bundle_id") or ""
                sock = e.get("sock") or ""
                cwd = e.get("cwd") or ""
except Exception:
    pass
if not cwd:
    for f in glob.glob(os.path.join(home, ".claude/sessions/*.json")):
        try:
            d = json.load(open(f))
        except Exception:
            continue
        if d.get("sessionId") == sid:
            cwd = d.get("cwd") or ""
            break
print(f"TERM_KIND={shlex.quote(term)} REF={shlex.quote(ref)} APP_BUNDLE={shlex.quote(bundle_id)} SOCK={shlex.quote(sock)} CWD={shlex.quote(cwd)}")
EOF
)"

case "$TERM_KIND" in
  kitty)
    # Window ids are per-instance — the publisher tells us which
    # instance's socket minted REF. Try that first; the blind sweep over
    # every live socket is only the legacy-snapshot fallback (and may
    # focus a same-id window of another instance, so it goes last).
    if [ -n "$REF" ] && [ -n "$KITTEN" ]; then
      # /tmp is world-writable, so these paths are untrusted: keep them in an
      # array rather than a space-joined string that re-splits and re-globs.
      CANDIDATES=()
      [ -n "$SOCK" ] && CANDIDATES+=("$SOCK")
      [ -n "$KITTY_LISTEN_ON" ] && CANDIDATES+=("$KITTY_LISTEN_ON")
      while IFS= read -r S; do
        [ -S "$S" ] && CANDIDATES+=("unix:$S")
      done < <(ls -t -d /tmp/kitty* 2>/dev/null)
      for S in "${CANDIDATES[@]}"; do
        if "$KITTEN" @ --to "$S" focus-window --match "id:$REF" >/dev/null 2>&1; then
          osascript -e 'tell application "kitty" to activate' >/dev/null 2>&1
          exit 0
        fi
      done
    fi
    ;;
  terminal)
    # ref = "<window id>:<tab index>" (Terminal tabs have no stable id).
    # Both halves go in as osascript arguments, never as script text: ref
    # comes from a file any local process can write, and interpolating it
    # into the source would let it inject its own AppleScript statements
    # (`do shell script`). Same argv form as the Ghostty/iTerm2 branches.
    WID=""; TIDX=""
    case "$REF" in *:*) WID="${REF%%:*}"; TIDX="${REF##*:}" ;; esac
    case "$WID" in ''|*[!0-9]*) WID="" ;; esac
    case "$TIDX" in ''|*[!0-9]*) WID="" ;; esac
    if [ -n "$WID" ]; then
      RESULT=$(osascript - "$WID" "$TIDX" <<'EOF' 2>/dev/null
on run argv
  set wid to (item 1 of argv) as integer
  set tidx to (item 2 of argv) as integer
  tell application "Terminal"
    set selected of tab tidx of window id wid to true
    set index of window id wid to 1
    activate
  end tell
  return "ok"
end run
EOF
)
      [ "$RESULT" = "ok" ] && exit 0
    fi
    open -a Terminal 2>/dev/null && exit 0
    ;;
  ghostty)
    # ref = terminal (surface) unique id. Ghostty exposes application-level
    # terminal lookup by that stable id; `focus` selects the surface's native
    # tab and brings its window forward. Do not rediscover the hierarchy here:
    # walking windows/tabs/terminals and then sending commands to the temporary
    # loop objects can hang Ghostty's preview AppleScript implementation.
    if [ -n "$REF" ]; then
      osascript - "$REF" <<'EOF' >/dev/null 2>&1 &
on run argv
  set targetID to item 1 of argv
  tell application "Ghostty"
    set targetTerminal to terminal id targetID
    activate
    focus targetTerminal
  end tell
end run
EOF
      AS_PID=$!
      # AppleScript support is explicitly preview-quality in Ghostty 1.3. A
      # bounded wait keeps a bad event from accumulating a stuck osascript on
      # every table/notification click. Five seconds is generous for a local
      # Apple Event while still making the app-level fallback useful.
      for _ in {1..50}; do
        kill -0 "$AS_PID" 2>/dev/null || break
        sleep 0.1
      done
      if kill -0 "$AS_PID" 2>/dev/null; then
        kill "$AS_PID" 2>/dev/null
        for _ in {1..10}; do
          kill -0 "$AS_PID" 2>/dev/null || break
          sleep 0.1
        done
        kill -KILL "$AS_PID" 2>/dev/null
        wait "$AS_PID" 2>/dev/null
      elif wait "$AS_PID"; then
        exit 0
      fi
    fi
    open -a Ghostty 2>/dev/null && exit 0
    ;;
  agterm)
    # ref = "<window id>:<session id>". agterm (com.umputun.agterm) has no
    # AppleScript dictionary — drive it over its control socket via agtermctl,
    # which ships in the app bundle (Homebrew symlinks it onto PATH).
    if [ -n "$REF" ]; then
      AWID="${REF%%:*}"; ASID="${REF##*:}"
      CTL="$(command -v agtermctl || true)"
      [ -x "$CTL" ] || CTL="/Applications/agterm.app/Contents/MacOS/agtermctl"
      if [ -x "$CTL" ] && [ -n "$ASID" ]; then
        "$CTL" window select "$AWID" >/dev/null 2>&1
        "$CTL" session select --target "$ASID" --window "$AWID" >/dev/null 2>&1
        open -b com.umputun.agterm >/dev/null 2>&1 && exit 0
      fi
    fi
    open -a agterm 2>/dev/null && exit 0
    ;;
  # xterm is ancestry-detected only (no scripting dictionary) — the best
  # we can do is bring XQuartz forward.
  xterm)
    open -a XQuartz 2>/dev/null && exit 0
    ;;
  # JetBrains IDEs: REF is the IDE bundle id. No per-tab focus API, so
  # we just bring the IDE app forward.
  jetbrains)
    ok_bundle "$REF" && open -b "$REF" 2>/dev/null && exit 0
    ;;
  # Any app bundle that has no dedicated adapter yet. Process ancestry gives
  # us its bundle id, which is enough for both automatic icons and activation.
  application)
    # Codex exposes a documented deep link for an exact local thread. Activating
    # the bundle alone lands on whichever thread happened to be visible last.
    if [ "$APP_BUNDLE" = "com.openai.codex" ] || [ "$REF" = "com.openai.codex" ]; then
      open "codex://threads/$SID" 2>/dev/null && exit 0
    fi
    ok_bundle "$APP_BUNDLE" && open -b "$APP_BUNDLE" 2>/dev/null && exit 0
    ok_bundle "$REF" && open -b "$REF" 2>/dev/null && exit 0
    ;;
  # Claude desktop (Code / local-agent mode) accepts a bridge session id in its
  # registered URL scheme, so open the exact session instead of whichever one
  # happened to be visible last. Live ~/.claude sessions already use SID as the
  # bridge id; indexed local_<uuid> sessions pass cliSessionId as argv[2] above.
  claude-desktop)
    open "claude://code/$SID" 2>/dev/null && exit 0
    ok_bundle "$REF" && open -b "$REF" 2>/dev/null && exit 0
    ;;
  iterm2)
    if [ -z "$REF" ]; then
      open -a iTerm 2>/dev/null && exit 0
    fi
    RESULT=$(osascript - "$REF" <<'EOF' 2>/dev/null
on run argv
  set target to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (unique ID of s) is target then
            select s
            select t
            select w
            activate
            return "ok"
          end if
        end repeat
      end repeat
    end repeat
  end tell
  return "notfound"
end run
EOF
)
    [ "$RESULT" = "ok" ] && exit 0
    ;;
esac

# No terminal window found — open a kitty at the session's cwd. No -n:
# spawning extra kitty instances is exactly what created untrackable
# windows in the first place; activating the running instance is the
# least-wrong landing.
if [ -n "$CWD" ] && [ -d "$CWD" ]; then
  open -a kitty --args --single-instance --directory "$CWD" 2>/dev/null && exit 0
  open -a Terminal "$CWD" 2>/dev/null && exit 0
fi
exit 1
